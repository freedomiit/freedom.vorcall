# Production secrets live only on the host; the versioned template is .env.production.example
/.env
# Local release build settings (server key); never committed
client/.env.release
# Probe credentials for the two production test accounts; never committed
client/.env.probe
client/target/
dist/
**/bin/
**/obj/
.vs/
.idea/
# Local release manifests and assets read by the dev server (Vorcall:ReleasesDir = ../releases); never committed
/releases/
# Local attachment storage read by the dev server (Vorcall:AttachmentsDir = ../attachments); never committed
/attachments/
