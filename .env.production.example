# Production: copy to `.env` next to docker-compose.prod.yml on the host and fill the secrets.
# deploy/provision-host.sh generates this file with random secrets on first run.
POSTGRES_DB=vorcall
POSTGRES_USER=vorcall
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
ConnectionStrings__Default=Host=db;Port=5432;Database=vorcall;Username=vorcall;Password=__POSTGRES_PASSWORD__
# Pre-shared door key. Bake the same value into client builds via VORCALL_SERVER_KEY.
Vorcall__ServerKey=__SERVER_KEY__
# HS256 signing key for access tokens: base64 of 32 random bytes. Rotating it signs every client out within 15 minutes.
Vorcall__JwtSigningKey=__JWT_SIGNING_KEY__
# Voice media relay (optional; defaults shown). VoiceHost empty means clients use the WebSocket host.
#Vorcall__VoiceEnabled=true
#Vorcall__VoicePort=5005
#Vorcall__VoiceHost=
# Client releases served by /api/updates/*.
#Vorcall__ReleasesDir=/releases   # default; ./releases is bind-mounted there by docker-compose.prod.yml
# Image attachments (optional; defaults shown).
#Vorcall__AttachmentsDir=/attachments   # default; ./attachments is bind-mounted there by docker-compose.prod.yml
#Vorcall__AttachmentsMaxBytes=2147483648   # default: 2 GiB total on-disk quota; uploads are refused with 507 when it would be exceeded
ASPNETCORE_ENVIRONMENT=Production
