# Production: copy to `.env` next to docker-compose.prod.yml on the host and fill the secrets.
# deploy/provision-host.sh generates this file with random secrets on first run.
POSTGRES_DB=vorcall
POSTGRES_USER=vorcall
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
ConnectionStrings__Default=Host=db;Port=5432;Database=vorcall;Username=vorcall;Password=__POSTGRES_PASSWORD__
# Pre-shared door key. Bake the same value into client builds via VORCALL_SERVER_KEY.
Vorcall__ServerKey=__SERVER_KEY__
# HS256 signing key for access tokens: base64 of 32 random bytes. Rotating it signs every client out within 15 minutes.
Vorcall__JwtSigningKey=__JWT_SIGNING_KEY__
# Voice media relay (optional; defaults shown). VoiceHost empty means clients use the WebSocket host.
#Vorcall__VoiceEnabled=true
#Vorcall__VoicePort=5005
#Vorcall__VoiceHost=
# Screen share (optional; defaults shown).
#Vorcall__ShareEnabled=true
#Vorcall__ShareMaxKbps=30000
#Vorcall__MaxSharersPerRoom=3
# Client releases served by /api/updates/*.
#Vorcall__ReleasesDir=/releases   # default; ./releases is bind-mounted there by docker-compose.prod.yml
# Admin key for the CLI's `users kick`/`users ban`, generated by deploy/provision-host.sh.
Vorcall__AdminKey=__ADMIN_KEY__
# Where `docker compose -f docker-compose.prod.yml run --rm backend ...` reaches the live server
# (a sibling container on the compose network).
Vorcall__AdminUrl=http://backend:5000
# Daily JSON logs (optional; default shown). ./logs is bind-mounted there by docker-compose.prod.yml.
#Vorcall__LogsDir=/logs
# Problem reports uploaded through /api/diagnostics (optional; default shown). ./diagnostics is bind-mounted there.
#Vorcall__DiagnosticsDir=/diagnostics
# Attachments (optional; defaults shown). Any file type, up to 2 GiB each.
#Vorcall__AttachmentsDir=/attachments   # default; ./attachments is bind-mounted there by docker-compose.prod.yml
# Total on-disk quota across every upload; past it an upload is refused, nothing stored is deleted.
# A quota, not a reservation: check the real free space on the volume behind ./attachments before raising it.
#Vorcall__AttachmentsMaxBytes=214748364800   # default: 200 GiB
# Streamed files (optional; defaults shown): served by the sender's own client and proxied, never stored here.
#Vorcall__StreamsEnabled=true
#Vorcall__StreamSenderTimeoutSeconds=30   # 1-600; how long a reader waits for the sender to answer before 504
#Vorcall__StreamMaxTransfersPerOwner=8    # 1-64; downloads one account may be asked to serve at once
ASPNETCORE_ENVIRONMENT=Production
