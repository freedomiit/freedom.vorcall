# Vorcall server settings. Copy to `.env` next to docker-compose.yml and edit
# what you need — every line here is optional, and the defaults are what you get
# with no `.env` at all.
#
#   cp .env.example .env
#   docker compose up -d
#
# Full reference: docs/self-hosting.md#configuration

# --- Where the server listens -----------------------------------------------

# Interface the API is published on. The default keeps it reachable only from
# this machine, which is what you want behind a reverse proxy that terminates
# TLS. Set 0.0.0.0 only if nothing is proxying it.
#VORCALL_BIND=127.0.0.1
#VORCALL_PORT=5000

# The voice and screen-share media relay. UDP, and necessarily reachable from
# the internet: a reverse proxy cannot carry it. Open this port in the host
# firewall AND in your cloud provider's security group, or voice will not work.
#VORCALL_VOICE_PORT=5005

# Hostname clients send media to. Empty means "the host the WebSocket came
# from", which is right unless the relay lives somewhere else.
#VORCALL_VOICE_HOST=

# --- Secrets ----------------------------------------------------------------

# The pre-shared door key every client sends. Left unset, one is generated on
# the first boot, saved in the `data` volume and printed once in the log:
#   docker compose logs backend | grep "Server key"
# Set it here to choose your own instead. Changing it locks out every client
# until they are given the new value.
#VORCALL_SERVER_KEY=

# Signs access tokens; base64 of 32 random bytes (`openssl rand -base64 32`).
# Generated and persisted like the key above when unset. Changing it signs
# everyone out within 15 minutes.
#VORCALL_JWT_SIGNING_KEY=

# Enables the admin endpoints that `users kick` / `disable` / `enable` use to
# close a live connection (`openssl rand -hex 32`). Without it those commands
# still lock the account, they just cannot hang up on it immediately.
#VORCALL_ADMIN_KEY=

# --- Features ---------------------------------------------------------------

# Server-wide kill switch for screen sharing. Voice keeps working with it off.
#VORCALL_SHARE_ENABLED=true

# Server-wide kill switch for streamed files — the large files a sender's own
# client serves, proxied through here and never stored. With it off the four
# /api/streams routes are not mapped and no message can offer one; attachments
# are unaffected.
#VORCALL_STREAMS_ENABLED=true

# How long a downloader's request waits for the sending client to start pushing
# bytes (or to decline) before it gives up with 504. Below 1 or above 600 the
# server refuses to boot rather than quietly clamping.
#VORCALL_STREAM_SENDER_TIMEOUT_SECONDS=30

# How many downloads one account may be asked to serve at the same time. Past
# this a further downloader is turned away instead of the sender's client being
# asked for one more range. Between 1 and 64.
#VORCALL_STREAM_MAX_TRANSFERS_PER_OWNER=8

# --- Storage ----------------------------------------------------------------

# Total bytes of uploaded attachments and images the server will keep, across
# everyone. Past it an upload is refused; nothing already stored is deleted.
# A single attachment may be up to 2 GiB, so this is what actually stands
# between uploads and a full disk. The default is 200 GiB — a quota, not a
# reservation: no space is set aside, and setting it above the volume's real
# free space just means the disk fills before the quota does. Check `df -h`
# on whatever backs the `attachments` volume before raising it.
#VORCALL_ATTACHMENTS_MAX_BYTES=214748364800

# --- Database ---------------------------------------------------------------

# Only reachable on loopback, never published to the network. Change the
# password before the first `up -d` if you like — after that it has to match
# what the database was initialised with.
#POSTGRES_USER=vorcall
#POSTGRES_PASSWORD=vorcall
#POSTGRES_DB=vorcall
#POSTGRES_PORT=5433
